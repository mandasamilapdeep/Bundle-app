{% comment %}
  Bundle Discount Widget Block
  Target: section — appears inside any section that supports app blocks in the Theme Editor
  Shows bundle products with tiered discounts (pick any 2 → 10% off, pick any 4 → 20% off, etc.)
{% endcomment %}

{%- assign app_url = shop.metafields.bundle_app.app_url | default: block.settings.app_url -%}
{%- assign shop_domain = shop.permanent_domain -%}
{%- assign pt = block.settings.padding_top | default: 36 -%}
{%- assign pb = block.settings.padding_bottom | default: 36 -%}

{%- style -%}
  #bundle-widget-{{ block.id }} {
    padding-top: {{ pt }}px;
    padding-bottom: {{ pb }}px;
  }
  @media screen and (max-width: 749px) {
    #bundle-widget-{{ block.id }} {
      padding-top: {{ pt | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ pb | times: 0.75 | round: 0 }}px;
    }
  }
{%- endstyle -%}

{% comment %} Ensure jQuery is loaded if the theme does not already provide it {% endcomment %}
<script>
  if (typeof window.jQuery === 'undefined' && !document.querySelector('script[src*="jquery"]')) {
    document.write('<script src="https://code.jquery.com/jquery-3.7.1.min.js"><\/script>');
  }
</script>

<div
  id="bundle-widget-{{ block.id }}"
  class="bundle-widget"
  style="padding-top: {{ pt }}px; padding-bottom: {{ pb }}px;"
  data-block-id="{{ block.id }}"
  data-shop="{{ shop_domain }}"
  data-app-url="{{ app_url }}"
  data-bundle-id="{{ block.settings.bundle_id | strip | escape }}"
  data-show-heading="{{ block.settings.show_heading }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-subheading="{{ block.settings.subheading | escape }}"
  data-accent-color="{{ block.settings.accent_color }}"
  data-badge-color="{{ block.settings.badge_color }}"
  data-cols="{{ block.settings.columns_desktop }}"
  data-show-price="{{ block.settings.show_price }}"
  data-button-text="{{ block.settings.button_text | escape }}"
  data-add-to-box-text="{{ block.settings.add_to_box_text | default: 'Add To Box' | escape }}"
  data-redirect="{{ block.settings.redirect_target | default: 'checkout' }}"
  {{ block.shopify_attributes }}
>
  <div class="bundle-widget__loader">
    <div class="bundle-widget__spinner"></div>
    <span>Loading bundle deals…</span>
  </div>
  <div class="bundle-widget__error" style="display:none">
    <p>Bundle deals could not be loaded.</p>
  </div>
  <div class="bundle-widget__content" style="display:none"></div>
</div>

{% schema %}
{
  "name": "Bundle Deals",
  "target": "section",
  "stylesheet": "bundle-widget.css",
  "javascript": "bundle-widget.js",
  "settings": [
    {
      "type": "header",
      "content": "Bundle Setup"
    },
    {
      "type": "text",
      "id": "bundle_id",
      "label": "Bundle ID",
      "info": "Paste the Bundle ID from your app to display only that bundle. (Find it under Manage bundles in the app)."
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL (fallback)",
      "info": "Your app URL from shopify app dev. Set it once in the app dashboard under 'App URL' — it is auto-read from there."
    },
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show Section Heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle Deals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick more, save more! Mix and match products to unlock discounts."
    },
    {
      "type": "header",
      "content": "Layout & Display"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add to Cart Button Text",
      "default": "Add Selected to Cart"
    },
    {
      "type": "text",
      "id": "add_to_box_text",
      "label": "Item Button Text",
      "default": "Add To Box",
      "info": "Text on the button before an item is added to the box"
    },
    {
      "type": "select",
      "id": "redirect_target",
      "label": "After adding to cart",
      "options": [
        { "value": "checkout", "label": "Go directly to Checkout" },
        { "value": "cart", "label": "Go to Cart page" }
      ],
      "default": "checkout"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Highlight Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Discount Badge Color",
      "default": "#e63946"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
