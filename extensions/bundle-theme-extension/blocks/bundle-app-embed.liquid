{% comment %}
  Bundle App Embed — loads the bundle widget script globally across the storefront.
  Target: body — toggled in Theme Editor under "App embeds".
{% endcomment %}

{% schema %}
{
  "name": "Bundle App",
  "target": "body",
  "stylesheet": "bundle-widget.css",
  "javascript": "bundle-widget.js",
  "settings": []
}
{% endschema %}
